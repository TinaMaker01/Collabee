DATABASE_URL=postgres://postgres:postgres@localhost:5432/collabee
# Must be a random string of at least 32 characters; known placeholder
# values (including this one) are rejected at startup. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-random-secret
PORT=3000
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT=100
LOG_LEVEL=info
